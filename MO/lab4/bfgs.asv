function [x, y, k, dots] = bfgs(func, x0, maxlambda, maxk, epsilon)
    
    n = length(x0);

    k = 0;
    x = x0;
    dots = [[x0;func(x0)]];

    g = gradient(func, x, epsilon);
    A = hesse(func, x0, epsilon)^(-1);
    dA = 0;

    while k < maxk
     
        g = gradient(func, x, epsilon);

        A = A + dA;



        s = - A*g;

        f = @(lambda) func(x+lambda*s);
        x = x  + s * gold(f, 0, maxlambda, epsilon);
        dx = x- x0;
        dg = gradient(func, x, epsilon) - g;
        dA = (1 + ((dg)'*A *dg)/(dx'*dg))*((dx*dx')/(dx'*dg)) - ((dx * dg' * A)/ (dx' * dg)) - ((A * dg * dx')/(dx' * dg));

        k = k + 1;
        
        if norm(gradient(func, x, epsilon)) <= epsilon 
            break
        end

        x0 = x;
        dots = [dots,[x;func(x)]];

   end
   y = func(x);

   disp(A + dA - hesse(func, x0, epsilon)^(-1));

end