
#include "stm32f1xx.h"
#include <stdint.h>
#include <stdio.h>

#define CMD_SIZE 32

int main(void)
{
    char command[CMD_SIZE];
    char response[32];
    uint32_t pos = 0;
    uint32_t raw;
    int32_t vsense_mv;
    int32_t t10;

    /* HSI 8 MHz */
    RCC->CR |= RCC_CR_HSION;
    while (!(RCC->CR & RCC_CR_HSIRDY)) {}
    RCC->CFGR = 0;

    /* GPIOA, AFIO, USART2 */
    RCC->APB2ENR |= RCC_APB2ENR_IOPAEN | RCC_APB2ENR_AFIOEN;
    RCC->APB1ENR |= RCC_APB1ENR_USART2EN;

    /* PA2 = USART2_TX */
    GPIOA->CRL &= ~(0xFUL << 8);
    GPIOA->CRL |=  (0xBUL << 8);

    /* PA3 = USART2_RX */
    GPIOA->CRL &= ~(0xFUL << 12);
    GPIOA->CRL |=  (0x4UL << 12);

    /* USART2 9600 8N1 */
    USART2->BRR = 833;
    USART2->CR1 = USART_CR1_TE | USART_CR1_RE | USART_CR1_UE;
    USART2->CR2 = 0;
    USART2->CR3 = 0;

    /* ADC1 clock */
    RCC->APB2ENR |= RCC_APB2ENR_ADC1EN;
    RCC->CFGR &= ~RCC_CFGR_ADCPRE;
    RCC->CFGR |= RCC_CFGR_ADCPRE_DIV6;

    /* Internal temperature sensor, channel 16 */
    ADC1->CR2 |= ADC_CR2_TSVREFE;
    ADC1->SMPR1 &= ~(7UL << 18);
    ADC1->SMPR1 |=  (7UL << 18);
    ADC1->SQR1 = 0;
    ADC1->SQR3 = 16;

    ADC1->CR2 |= ADC_CR2_ADON;
    for (volatile uint32_t i = 0; i < 10000; i++) {}

    ADC1->CR2 |= ADC_CR2_RSTCAL;
    while (ADC1->CR2 & ADC_CR2_RSTCAL) {}

    ADC1->CR2 |= ADC_CR2_CAL;
    while (ADC1->CR2 & ADC_CR2_CAL) {}

    /* Software-trigger selection: EXTSEL = 111 */
    ADC1->CR2 &= ~ADC_CR2_EXTSEL;
    ADC1->CR2 |= ADC_CR2_EXTSEL;
    ADC1->CR2 |= ADC_CR2_EXTTRIG;

    /* Startup message */
    {
        const char msg[] = "Thermometer ready\r\n";
        for (uint32_t i = 0; i < sizeof(msg) - 1; i++) {
            while (!(USART2->SR & USART_SR_TXE)) {}
            USART2->DR = (uint16_t)msg[i];
        }
    }

    while (1)
    {
        while (!(USART2->SR & USART_SR_RXNE)) {}
        char c = (char)(USART2->DR & 0xFF);

        /* Enter terminates the command; ignore NUL bytes */
        if (c == '\r' || c == '\n')
        {
            if (pos == 0)
                continue;

            command[pos] = '\0';

            while (!(USART2->SR & USART_SR_TXE)) {}
            USART2->DR = (uint16_t)"\r\n";
            if (pos == 12 &&
                command[0]  == 'T' &&
                command[1]  == 'E' &&
                command[2]  == 'M' &&
                command[3]  == 'P' &&
                command[4]  == 'E' &&
                command[5]  == 'R' &&
                command[6]  == 'A' &&
                command[7]  == 'T' &&
                command[8]  == 'U' &&
                command[9]  == 'R' &&
                command[10] == 'E' &&
                command[11] == '?')
            {
                ADC1->SR = 0;
                ADC1->CR2 |= ADC_CR2_SWSTART;

                while (!(ADC1->SR & ADC_SR_EOC)) {}
                raw = ADC1->DR;

                /* Approximate temperature calculation */
                vsense_mv = (int32_t)((raw * 3.3f) / 4096);
                t10 = (1.34f - vsense_mv)/0.0043f + 25;

                if (t10 < 0) {
                    snprintf(response, sizeof(response), "-%ld.%ld C\r\n",
                             (long)(-t10 / 10), (long)(-t10 % 10));
                } else {
                    snprintf(response, sizeof(response), "%ld.%ld C\r\n",
                             (long)(t10 / 10), (long)(t10 % 10));
                }

                for (uint32_t i = 0; response[i] != '\0'; i++) {
                    while (!(USART2->SR & USART_SR_TXE)) {}
                    USART2->DR = (uint16_t)response[i];
                }

                while (!(USART2->SR & USART_SR_TXE)) {}
                USART2->DR = 0x00;
            }
            else
            {
                const char error[] = "Unknown command\r\n";

                for (uint32_t i = 0; i < sizeof(error) - 1; i++) {
                    while (!(USART2->SR & USART_SR_TXE)) {}
                    USART2->DR = (uint16_t)error[i];
                }

                while (!(USART2->SR & USART_SR_TXE)) {}
                USART2->DR = 0x00;
            }

            pos = 0;
        }
        else if (c != '\0' && pos < CMD_SIZE - 1)
        {
            command[pos++] = c;
        }
        else if (pos >= CMD_SIZE - 1)
        {
            pos = 0;
        }
    }
}
