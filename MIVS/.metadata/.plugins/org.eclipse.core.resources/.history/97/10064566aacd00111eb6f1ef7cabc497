
#include "stm32f1xx.h"
#include <stdint.h>
#include <stdio.h>
#include <string.h>

/*
 * STM32F103C8T6
 * HSE = 8 MHz, PLL x8 = 64 MHz
 * USART2: 9600, 8N1
 * Command: "TEMPERATURE?" + 0x00
 * Response: ASCII string + 0x00
 *
 * VDDA assumed to be 3.3 V.
 */

#define CMD_SIZE 32

static volatile uint32_t adc_value;




#include "stm32f1xx.h"

int main(void)
{
    /* Тактирование GPIOA и USART2 */
    RCC->APB2ENR |= RCC_APB2ENR_IOPAEN;
    RCC->APB1ENR |= RCC_APB1ENR_USART2EN;

    /* PA2 = USART2_TX, alternate function push-pull */
    GPIOA->CRL &= ~(0xFUL << 8);
    GPIOA->CRL |=  (0xBUL << 8);

    RCC->CR |= RCC_CR_HSION;
    while (!(RCC->CR & RCC_CR_HSIRDY)) {}
    RCC->CFGR = 0;

    /* HSI = 8 MHz, PCLK1 = 8 MHz, USART = 9600 */
    USART2->BRR = 833;
    USART2->CR1 = USART_CR1_TE | USART_CR1_UE;

    while (1)
    {
        const char msg[] = "hello\r\n";

        for (int i = 0; i < 7; i++)
        {
            while (!(USART2->SR & USART_SR_TXE)) {}
            USART2->DR = msg[i];
        }

        /* Пауза */
        for (volatile int d = 0; d < 500000; d++) {}
    }
}

