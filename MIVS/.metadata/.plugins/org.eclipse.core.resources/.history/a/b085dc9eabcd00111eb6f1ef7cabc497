
#include "stm32f1xx.h"
#include <stdint.h>
#include <stdio.h>
#include <string.h>

#define CMD_SIZE 32

int main(void)
{
    char command[CMD_SIZE];
    char response[32];
    uint32_t pos = 0;
    uint32_t raw;
    int32_t vsense_mv;
    int32_t t10;

    /* HSI = 8 MHz, SYSCLK = 8 MHz, PCLK1 = 8 MHz */
    RCC->CR |= RCC_CR_HSION;
    while (!(RCC->CR & RCC_CR_HSIRDY)) {}
    RCC->CFGR = 0;

    /* Включаем GPIOA, AFIO и USART2 */
    RCC->APB2ENR |= RCC_APB2ENR_IOPAEN | RCC_APB2ENR_AFIOEN;
    RCC->APB1ENR |= RCC_APB1ENR_USART2EN;

    /* PA2 = USART2_TX, alternate function push-pull */
    GPIOA->CRL &= ~(0xFUL << 8);
    GPIOA->CRL |=  (0xBUL << 8);

    /* PA3 = USART2_RX, input floating */
    GPIOA->CRL &= ~(0xFUL << 12);
    GPIOA->CRL |=  (0x4UL << 12);

    /* USART2: 9600, 8N1 */
    USART2->BRR = 833;
    USART2->CR1 = USART_CR1_TE | USART_CR1_RE | USART_CR1_UE;
    USART2->CR2 = 0;
    USART2->CR3 = 0;

    /* Включаем ADC1 */
    RCC->APB2ENR |= RCC_APB2ENR_ADC1EN;

    /* ADC clock = PCLK2 / 6 */
    RCC->CFGR &= ~RCC_CFGR_ADCPRE;
    RCC->CFGR |= RCC_CFGR_ADCPRE_DIV6;

    /* Включаем температурный датчик */
    ADC1->CR2 |= ADC_CR2_TSVREFE;

    /* Длительность выборки канала 16 = 239.5 циклов */
    ADC1->SMPR1 &= ~(7UL << 18);
    ADC1->SMPR1 |=  (7UL << 18);

    /* Одна конверсия, канал 16 */
    ADC1->SQR1 = 0;
    ADC1->SQR3 = 16;

    /* Включаем ADC */
    ADC1->CR2 |= ADC_CR2_ADON;

    for (volatile uint32_t i = 0; i < 10000; i++) {}

    /* Калибровка ADC */
    ADC1->CR2 |= ADC_CR2_RSTCAL;
    while (ADC1->CR2 & ADC_CR2_RSTCAL) {}

    ADC1->CR2 |= ADC_CR2_CAL;
    while (ADC1->CR2 & ADC_CR2_CAL) {}

    /* Разрешаем программный запуск преобразования */
    ADC1->CR2 |= ADC_CR2_EXTTRIG;

    /* Отправляем сообщение при запуске */
    {
        const char hello[] = "Thermometer ready\r\n";

        for (uint32_t i = 0; i < sizeof(hello) - 1; i++) {
            while (!(USART2->SR & USART_SR_TXE)) {}
            USART2->DR = (uint16_t)hello[i];
        }
    }

    while (1)
    {
        /* Принимаем символ USART2 */
        while (!(USART2->SR & USART_SR_RXNE)) {}
        char c = (char)(USART2->DR & 0xFF);

        /* Команда заканчивается Enter или нулевым байтом */
        if (strcmp(command, "TEMPERATURE?") == 0)
        {
            ADC1->SR = 0;
            ADC1->CR2 |= ADC_CR2_SWSTART;

            while (!(ADC1->SR & ADC_SR_EOC)) {}
            raw = ADC1->DR;

            vsense_mv = (int32_t)((raw * 3300UL) / 4095UL);
            t10 = (((1430 - vsense_mv) * 100) / 43) + 250;

            if (t10 < 0) {
                snprintf(response, sizeof(response), "-%ld.%ld C",
                         (long)(-t10 / 10), (long)(-t10 % 10));
            } else {
                snprintf(response, sizeof(response), "%ld.%ld C",
                         (long)(t10 / 10), (long)(t10 % 10));
            }

            for (uint32_t i = 0; response[i] != '\0'; i++) {
                while (!(USART2->SR & USART_SR_TXE)) {}
                USART2->DR = (uint16_t)response[i];
            }

            while (!(USART2->SR & USART_SR_TXE)) {}
            USART2->DR = 0;
        }
        else
        {
            /* Показываем принятую команду для диагностики */
            const char prefix[] = "Received: ";

            for (uint32_t i = 0; i < sizeof(prefix) - 1; i++) {
                while (!(USART2->SR & USART_SR_TXE)) {}
                USART2->DR = (uint16_t)prefix[i];
            }

            for (uint32_t i = 0; command[i] != '\0'; i++) {
                while (!(USART2->SR & USART_SR_TXE)) {}
                USART2->DR = (uint16_t)command[i];
            }

            const char suffix[] = "\r\nUnknown command\r\n";

            for (uint32_t i = 0; i < sizeof(suffix) - 1; i++) {
                while (!(USART2->SR & USART_SR_TXE)) {}
                USART2->DR = (uint16_t)suffix[i];
            }

            while (!(USART2->SR & USART_SR_TXE)) {}
            USART2->DR = 0;
        }
            else
            {
                const char error[] = "Unknown command\r\n";

                for (uint32_t i = 0; i < sizeof(error) - 1; i++) {
                    while (!(USART2->SR & USART_SR_TXE)) {}
                    USART2->DR = (uint16_t)error[i];
                }

                while (!(USART2->SR & USART_SR_TXE)) {}
                USART2->DR = 0;
            }

            pos = 0;
        }
        else if (pos < CMD_SIZE - 1)
        {
            command[pos++] = c;
        }
        else
        {
            pos = 0;
        }
    }
}
